DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "HiSPEC-TIB Firmware"
PROJECT_NUMBER         = 0.1
PROJECT_BRIEF          = "Zephyr firmware for HISPEC FIB board controllers"
OUTPUT_DIRECTORY       = _build_doxygen

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ..
STRIP_FROM_INC_PATH    = ../app/src ../include ../lib/coo_commons

OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
# Breathe's C domain supplies identifier links. Doxygen prose autolinks use
# std:ref targets that Sphinx does not register inside C declarations.
AUTOLINK_SUPPORT       = NO
INPUT                  = ../app/src \
                         ../include/coo_commons \
                         ../lib/coo_commons \
                         ../drivers/gpio/ds2408/drivers/gpio

# Publish header contracts. File-local implementation rationale stays in source;
# extracting every C file creates links to internals with no reference page.
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXCLUDE                = ../app/build \
                         ../app/refrence_docs_examples

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
SKIP_FUNCTION_MACROS   = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

QUIET                  = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
