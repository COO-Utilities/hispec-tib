# This file is the application Kconfig entry point. All application Kconfig
# options can be defined here or included via other application Kconfig files.
# You can browse these options using the west targets menuconfig (terminal) or
# guiconfig (GUI).

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

config NET_DHCPV4_OPTION_NTP_SERVER
	default y if SNTP && NET_DHCPV4

config APP_DEFAULT_DNS_SERVER
	string "Default manual DNS server IPv4 address"
	default "0.0.0.0"
	help
	  Default app-owned manual DNS server stored in the initial settings
	  snapshot. Use 0.0.0.0 to leave manual DNS disabled.

config APP_DEFAULT_NTP_SERVER
	string "Default manual NTP server IPv4 address"
	default "0.0.0.0"
	help
	  Default app-owned manual NTP server stored in the initial settings
	  snapshot. The current settings schema stores IPv4 strings, not
	  hostnames. Use 0.0.0.0 to prefer DHCP-provided NTP.

config SET_SWITCH_STATE_AT_BOOT
	bool "Reassert persisted MEMS static switch state at boot"
	default y
	help
	  If enabled, boot initializes each MEMS switch target from the last
	  user-commanded static state stored in app settings. The first MEMS
	  service tick then resends that pulse because firmware cannot verify
	  physical switch position across reboot or offline changes.

config RESUME_TOGGLE_STATE_AT_BOOT
	bool "Resume persisted MEMS toggle and split requests at boot"
	default n
	help
	  If enabled, boot restarts persisted MEMS toggle/split requests using
	  their originally commanded duration. Runtime remaining time is not
	  preserved across reboot because doing so would require frequent NVS
	  writes while switching.

choice SNTP_LOG_LEVEL_CHOICE
	default SNTP_LOG_LEVEL_DBG if SNTP
endchoice

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"
