+/**
+ * Quiesce an interrupt-driven RTU client between requests. Caller holds
+ * iface_lock and may sleep while a running RX work item finishes. Leaves
+ * the parsed rx_adu intact for client validation; other modes are unchanged.
+ */
+void modbus_serial_client_quiesce(struct modbus_context *ctx);
+
 /**
