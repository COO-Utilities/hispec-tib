 static void uart_cb_async_handler(const struct device *dev, struct uart_event *evt, void *app_data)
@@ -500,7 +508,48 @@ static void rtu_tmr_handler(struct k_timer *t_id)
 		return;
 	}
 
-	k_work_submit(&ctx->server_work);
+	if (ctx->client && !IS_ENABLED(CONFIG_MODBUS_SERIAL_ASYNC_API)) {
+		unsigned int key = irq_lock();
+
+		/* Freeze this frame before handing it to a possibly delayed worker.
+		 * Stop any timer rearmed by a byte just before this callback ran.
+		 * RX may already be off because the buffer filled; still submit it.
+		 */
+		modbus_serial_rx_off(ctx);
+		k_timer_stop(&ctx->cfg->rtu_timer);
+		k_work_submit(&ctx->server_work);
+		irq_unlock(key);
+	} else {
+		k_work_submit(&ctx->server_work);
+	}
+}
+
+void modbus_serial_client_quiesce(struct modbus_context *ctx)
+{
+	struct modbus_serial_config *cfg = ctx->cfg;
+	struct k_work_sync sync;
+	unsigned int key;
+
+	if (!ctx->client || ctx->mode != MODBUS_MODE_RTU ||
+	    IS_ENABLED(CONFIG_MODBUS_SERIAL_ASYNC_API)) {
+		return;
+	}
+
+	/* UP: stop every ISR producer before waiting for the parser. A pending
+	 * TX completion must not re-enable RX after a timeout. Never wait with
+	 * interrupts masked, or while running on the parser's workqueue.
+	 */
+	key = irq_lock();
+	modbus_serial_rx_off(ctx);
+	modbus_serial_tx_off(ctx);
+	k_timer_stop(&cfg->rtu_timer);
+	irq_unlock(key);
+	k_work_cancel_sync(&ctx->server_work, &sync);
+
+	modbus_serial_rx_fifo_drain(ctx);
+	cfg->uart_buf_ctr = 0;
+	cfg->uart_buf_ptr = cfg->uart_buf;
+	k_sem_reset(&ctx->client_wait_sem);
 }
 
