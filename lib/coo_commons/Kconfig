config COO_COMMONS
	bool "COO common libraries"
	default y
	help
	  Enable COO common libraries including PID controller,
	  network utilities, JSON helpers, and MQTT client.

if COO_COMMONS

config COO_NETWORK
	bool "COO network utilities"
	depends on NETWORKING
	default n
	help
	  Enable simple network bootstrap helper with DHCP/static/fallback
	  IPv4 handling and link-state monitoring.

if COO_NETWORK

config NETWORK_HELPER_ENABLE_DHCP
	bool "Enable DHCP handling in network helper"
	depends on NET_DHCPV4
	default y
	help
	  When enabled, network helper can attempt DHCP before static
	  or after static depending on runtime config.

config NETWORK_HELPER_ENABLE_DNS
	bool "Expose DNS configuration fields in network helper"
	depends on DNS_RESOLVER
	default y
	help
	  Enables DNS fields in network helper profiles. The helper itself
	  does not implement command handling or policy.

config NETWORK_HELPER_ENABLE_NTP
	bool "Expose NTP configuration fields in network helper"
	depends on SNTP
	default y
	help
	  Enables NTP fields in network helper profiles. The helper itself
	  does not implement command handling or policy.

config NETWORK_HELPER_DHCP_TIMEOUT_MS
	int "DHCP wait timeout (ms)"
	default 6000
	help
	  Timeout used when attempting DHCP before selecting static/fallback
	  IPv4 profiles. Set to 0 to wait indefinitely.

config NETWORK_HELPER_STATIC_IPV4_ADDR
	string "Default static IPv4 address"
	default NET_CONFIG_MY_IPV4_ADDR
	help
	  Compile-time static IPv4 address used by network helper.

config NETWORK_HELPER_STATIC_IPV4_NETMASK
	string "Default static IPv4 netmask"
	default NET_CONFIG_MY_IPV4_NETMASK
	help
	  Compile-time static IPv4 netmask used by network helper.

config NETWORK_HELPER_STATIC_IPV4_GW
	string "Default static IPv4 gateway"
	default NET_CONFIG_MY_IPV4_GW
	help
	  Compile-time static IPv4 gateway used by network helper.

config NETWORK_HELPER_STATIC_DNS_IPV4_ADDR
	string "Default static DNS IPv4"
	default "0.0.0.0"
	depends on NETWORK_HELPER_ENABLE_DNS

config NETWORK_HELPER_STATIC_NTP_IPV4_ADDR
	string "Default static NTP IPv4"
	default "0.0.0.0"
	depends on NETWORK_HELPER_ENABLE_NTP

config NETWORK_HELPER_FALLBACK_IPV4_ADDR
	string "Fallback service IPv4 address"
	default "192.168.88.2"
	help
	  Last-resort static address for direct service connectivity.

config NETWORK_HELPER_FALLBACK_IPV4_NETMASK
	string "Fallback service IPv4 netmask"
	default "255.255.255.0"

config NETWORK_HELPER_FALLBACK_IPV4_GW
	string "Fallback service IPv4 gateway"
	default "0.0.0.0"

endif # COO_NETWORK

config COO_JSON
	bool "COO JSON utilities"
	depends on JSON_LIBRARY
	default n
	help
	  Enable lightweight JSON helper wrappers used by command handling
	  (msg_type parsing, keyed primitive extraction, and key splitting).

config COO_MQTT
	bool "COO MQTT client wrapper"
	depends on MQTT_LIB
	select COO_NETWORK
	default n
	help
	  Enable COO MQTT client wrapper with automatic retry,
	  subscription management, and optional TLS support.
	  Provides a simplified interface over Zephyr's MQTT library
	  with built-in connection management. Requires MQTT_LIB.

if COO_MQTT

config COO_MQTT_BROKER_HOSTNAME
	string "MQTT broker hostname"
	default "test.mosquitto.org"
	help
	  Default MQTT broker hostname for DNS resolution.

config COO_MQTT_BROKER_PORT
	string "MQTT broker port"
	default "1883"
	help
	  Default MQTT broker port (1883 for plain, 8883 for TLS).

config COO_MQTT_PAYLOAD_SIZE
	int "Maximum MQTT payload size"
	default 512
	help
	  Maximum size for MQTT message payloads. This defines the
	  size of RX and TX buffers (2x this value total).

endif # COO_MQTT

endif # COO_COMMONS
